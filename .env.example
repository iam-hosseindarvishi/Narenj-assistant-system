# Copy to .env and adjust before deploying
JWT_SECRET=please-generate-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# CORS for the backend (frontend is served with a relative /api base through nginx)
CORS_ORIGINS=http://localhost:8080,http://192.168.1.10:8080
# Override only if you bypass the nginx proxy and call the backend cross-origin
VITE_API_BASE_URL=/api
